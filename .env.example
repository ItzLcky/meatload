# ─── Required ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Run the container as this uid:gid so it can write ./data. Check yours with
# `id -u` and `id -g` on the host.
PUID=1000
PGID=1000

# ─── Core ────────────────────────────────────────────────────────────────────
# Prefix for text commands. Every command also works as a slash command.
# Mentioning the bot always works as a prefix too.
DEFAULT_PREFIX=!

# Comma-separated user IDs allowed to run owner-only commands (reload, sync,
# shutdown). Leave blank to fall back to the application owner from Discord.
OWNER_IDS=

# Comma-separated guild IDs. Slash commands are pushed to these servers
# instantly instead of taking up to an hour to propagate globally.
# Set this to your server's ID — for a private bot there is no reason not to.
DEV_GUILD_IDS=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path to the SQLite database inside the container (keep it under /app/data).
DATABASE_PATH=/app/data/bot.db

# "Listening to ..." status text. Leave blank for no custom status.
ACTIVITY_NAME=music with friends
# playing | listening | watching | competing
ACTIVITY_TYPE=listening

# ─── Music ───────────────────────────────────────────────────────────────────
# Pull the newest yt-dlp on every container start. Costs a few seconds of
# boot time and fixes most YouTube breakage without rebuilding the image.
YTDLP_AUTO_UPDATE=true

# Leave the voice channel after this many seconds with nothing playing.
MUSIC_IDLE_TIMEOUT=300
# Leave this many seconds after the last human leaves the voice channel.
MUSIC_ALONE_TIMEOUT=60
# Default volume for a fresh player, 0-200.
MUSIC_DEFAULT_VOLUME=50
# Refuse to queue more than this many tracks per guild.
MUSIC_MAX_QUEUE=500
# Cap on tracks pulled from a single playlist link.
MUSIC_MAX_PLAYLIST=200

# Optional escape hatch for YouTube's bot checks. Export cookies from a browser
# to ./cookies/cookies.txt (Netscape format) and set this path.
# YTDLP_COOKIES_FILE=/app/cookies/cookies.txt

# Optional yt-dlp extractor tuning, passed straight through as
# --extractor-args. If YouTube extraction starts failing, the community fix
# is usually a value for this. Example:
#   YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,-web_creator
YTDLP_EXTRACTOR_ARGS=

# Optional. Lets the bot expand Spotify track/album/playlist links by looking
# up their metadata and finding the audio on YouTube. Without these, Spotify
# links are rejected with a clear message. Create an app at
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
